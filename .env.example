# Seven Test TUI Configuration

# Backend API endpoint - CloudFront front door (WAF). Note the ".cf." host.
API_ENDPOINT=https://se7-int-dev.dev.cf.playtheseven.com

# API key for the front door / WAF (sent as the x-seven-api-key header).
# Use the same value as the mobile app's .env API_KEY. Required.
API_KEY=your-api-key-here

# Cognito User Pool ID (find in AWS Cognito → User Pools)
USER_POOL_ID=eu-west-2_uqwEOLO5d

# Cognito App Client ID (find in AWS Cognito → User Pools → App Clients)
CLIENT_ID=your-client-id-here

# Environment prefix (e.g., int-dev, SE7-2001)
PREFIX=int-dev

# AWS Region
AWS_REGION=eu-west-2
