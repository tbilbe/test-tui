# Seven Test TUI Configuration

# Backend API endpoint - CloudFront front door (WAF). Note the ".cf." host.
API_ENDPOINT=https://se7-int-dev.dev.cf.playtheseven.com

# API key for the front door / WAF (sent as the x-seven-api-key header).
# Use the same value as the mobile app's .env API_KEY. Required for the TUI.
API_KEY=your-api-key-here

# Required Seven auth-server KMS-signed JWT. This is NOT a bwin/Entain token.
# In simulator dev tools, copy Authorization from a /game-weeks request without Bearer.
# The token is short-lived; recapture it after expiry or rejection.
SEVEN_ACCESS_TOKEN=your-seven-access-token-here

# Set exactly true to enable writes. Writes also require SE7-* or int-dev prefixes.
SEVEN_TUI_ALLOW_WRITES=false

# Environment prefix (e.g., int-dev, SE7-2001)
PREFIX=int-dev

# AWS Region
AWS_REGION=eu-west-2
