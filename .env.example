# Seven Test TUI Configuration

# Backend API endpoint - CloudFront front door (WAF). Note the ".cf." host.
API_ENDPOINT=https://se7-int-dev.dev.cf.playtheseven.com

# API key for the front door / WAF (sent as the x-seven-api-key header).
# Use the same value as the mobile app's .env API_KEY. Required for the TUI.
API_KEY=your-api-key-here

# Optional manual escape hatch for a Seven auth-server KMS-signed JWT.
# This is NOT a raw bwin/Entain token and is not the recommended workflow.
# Run `seven-test-tui bootstrap` to store a rotating refresh-token session instead.
SEVEN_ACCESS_TOKEN=

# Environment prefix (e.g., int-dev, SE7-2001)
PREFIX=int-dev

# AWS Region
AWS_REGION=eu-west-2
